# Dayflow HRMS - Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Default SQLite for local zero-config dev, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# PostgreSQL Example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow_db?schema=public"

# Authentication Secrets (Generate strong random 256-bit keys in production)
JWT_ACCESS_SECRET="dayflow_super_secret_access_jwt_key_2026_hackathon_demo"
JWT_REFRESH_SECRET="dayflow_super_secret_refresh_jwt_key_2026_hackathon_demo"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# BCrypt Salt Rounds
BCRYPT_SALT_ROUNDS=12
